{
  "manifest_version": 2,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "0.1.0",
  "default_locale": "en",
  "icons": {
    "48": "icons/kamurafox.svg",
    "96": "icons/kamurafox.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "kamurafox@gabrielkamura",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent", "browsingActivity"]
      }
    }
  },
  "permissions": ["<all_urls>", "tabs", "tabGroups", "nativeMessaging", "webNavigation", "webRequest", "storage"],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_title": "__MSG_extName__",
    "default_icon": "icons/kamurafox.svg",
    "default_popup": "popup/popup.html"
  }
}
